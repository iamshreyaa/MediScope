# Copy this file to backend/.env and fill in your own values.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=patient_assistant

# Firebase: absolute path to the service account key JSON you downloaded
# (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_CREDENTIALS=/absolute/path/to/backend/serviceAccountKey.json

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional overrides
# GEMINI_SEARCH_MODEL=gemini-2.5-flash   # model used for the online product lookup
# GEMINI_AUDIO_MODEL=                    # model used for voice dictation (defaults to GEMINI_MODEL)
# GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite  # model that grades replies in the evaluation suite
